// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"        // Note: was "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  username  String    @unique
  password  String
  xp        Int       @default(0)
  level     Int       @default(1)
  streak    Int       @default(0)
  tasks     Task[]
  memories  Memory[]
  chats     Chat[]
  xpLogs    XPLog[]
  createdAt DateTime  @default(now())
}

model Task {
  id        String   @id @default(uuid())
  title     String
  type      String   @default("DAILY") // DAILY, WEEKLY, EPIC
  category  String   @default("General") // Coding, Fitness, YouTube, etc.
  status    String   @default("PENDING") // PENDING, COMPLETED
  dueDate   DateTime?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  parentId  String?
  parent    Task?    @relation("SubTasks", fields: [parentId], references: [id])
  subTasks  Task[]   @relation("SubTasks")
}

model Memory {
  id        String   @id @default(uuid())
  userId    String
  content   String   // e.g., "User struggles with morning focus"
  category  String?  // e.g., "Habit", "Goal", "Preference"
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Chat {
  id        String    @id @default(uuid())
  userId    String
  messages  Message[]
  user      User      @relation(fields: [userId], references: [id])
  updatedAt DateTime  @updatedAt
}

model Message {
  id        String   @id @default(uuid())
  chatId    String
  role      String   // "user" or "assistant"
  content   String
  chat      Chat     @relation(fields: [chatId], references: [id])
  createdAt DateTime @default(now())
}

model XPLog {
  id        String   @id @default(uuid())
  userId    String
  amount    Int      // Positive for gain, negative for penalty
  reason    String   // e.g., "Completed Daily Run"
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}